// The mutations of the Lean model of design §5 and its proofs: each breaks the model one way,
// and must be caught by `zig build spec-lean`, its proofs or its replay (docs/mutations.md).
// tools/mutations.zig runs them. An edit replaces `old`, which must occur once, with `new`.
.{
    .{
        .section = "The Lean model and the replay",
        .id = "M1",
        .what = "the model keeps EDNS0 off at the next server",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    { s with server := s.server + 1, stage := fresh c, edns := true, cookieRetried := false,\n", .new = "    { s with server := s.server + 1, stage := fresh c, cookieRetried := false,\n" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The Lean model and the replay",
        .id = "M2",
        .what = "the model ignores TC=1 over a stream",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if stream then (nextCandidate c s true, .accepted)\n    else ({ s with stage := .tcpNeeded }, .accepted)", .new = "    if stream then (s, .ignored)\n    else ({ s with stage := .tcpNeeded }, .accepted)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The Lean model and the replay",
        .id = "P1",
        .what = "sent_lt proved by sorry",
        .edits = .{
            .{ .file = "spec/lean/Spec/LookupProofs/Measure.lean", .old = "    LexLt (measure c (step c s .sent).1) (measure c s) := by\n  rcases h with h | h <;> simp [step, measure, LexLt, phase, stagePhase, h]", .new = "    LexLt (measure c (step c s .sent).1) (measure c s) := by\n  sorry" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "DoH's DNS half",
        .id = "DM1",
        .what = "a reply over DoH is read as a datagram's",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "  | .awaitingUdp => onReply c s c.request r", .new = "  | .awaitingUdp => onReply c s false r" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "DoH's DNS half",
        .id = "DM2",
        .what = "a poll over DoH asks for a datagram",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "if c.request then .sendRequest else .sendUdp)", .new = "if false then .sendRequest else .sendUdp)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "DoH's DNS half",
        .id = "DM3",
        .what = "an HTTP failure changes nothing",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if c.request ∧ s.stage = .awaitingUdp then (advanceServer c (keep s .request), .none)\n    else (s, .none)", .new = "    if c.request ∧ s.stage = .awaitingUdp then (s, .none)\n    else (s, .none)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A refusal is a failure",
        .id = "RF1",
        .what = "the model counts a failed connection as silence",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if onStream s.stage then (advanceServer c (keep s (streamCause s.stage)), .none)\n", .new = "    if onStream s.stage then (advanceServer c s, .none)\n" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A refusal is a failure",
        .id = "RF2",
        .what = "the model counts a failed request as silence",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if c.request ∧ s.stage = .awaitingUdp then (advanceServer c (keep s .request), .none)", .new = "    if c.request ∧ s.stage = .awaitingUdp then (advanceServer c s, .none)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A fresh client cookie until a server cookie pairs with it",
        .id = "CO22",
        .what = "the model advances the server at a first BADCOOKIE over a stream, as before #36",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "      if c.request || s.cookieRetried then (advanceServer c (keep s .badcookie), .accepted)", .new = "      if c.request || s.cookieRetried || stream then (advanceServer c (keep s .badcookie), .accepted)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A fresh client cookie until a server cookie pairs with it",
        .id = "CO23",
        .what = "the model retries a BADCOOKIE over DoH or DoQ on a stream",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "      if c.request || s.cookieRetried then (advanceServer c (keep s .badcookie), .accepted)", .new = "      if s.cookieRetried then (advanceServer c (keep s .badcookie), .accepted)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A fresh client cookie until a server cookie pairs with it",
        .id = "CO24",
        .what = "the model's retry over a stream does not spend the server's retry",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "      else ({ s with cookieRetried := true, stage := .tcpNeeded }, .accepted)", .new = "      else ({ s with stage := .tcpNeeded }, .accepted)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC22",
        .what = "the model keeps the cause FORMERR at SERVFAIL",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "  | .servfail => (advanceServer c (keep s .servfail), .accepted)", .new = "  | .servfail => (advanceServer c (keep s .formerr), .accepted)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC23",
        .what = "the model's cause of a failed stream is the connect's in every stage",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "def streamCause (s : Stage) : Cause := if s = .connectingTcp then .connect else .stream", .new = "def streamCause (_ : Stage) : Cause := .connect" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC24",
        .what = "the model's failed request keeps the stream's cause",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if c.request ∧ s.stage = .awaitingUdp then (advanceServer c (keep s .request), .none)", .new = "    if c.request ∧ s.stage = .awaitingUdp then (advanceServer c (keep s .stream), .none)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC25",
        .what = "the model keeps the first cause, and a later server failure does not replace it",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "def keep (s : State) (k : Cause) : State := { s with cause := some k }", .new = "def keep (s : State) (k : Cause) : State := { s with cause := s.cause <|> some k }" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC26",
        .what = "the model forgets the cause at the end of its last pass",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    fail { s with round := s.round + 1 } (if s.cause.isSome then .allServersFailed else .timeout)", .new = "    fail { s with round := s.round + 1, cause := none } (if s.cause.isSome then .allServersFailed else .timeout)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC27",
        .what = "the model's walk writes no cause",
        .edits = .{
            .{ .file = "spec/lean/Main.lean", .old = "    out.putStrLn s!\"{depth + 1} {eventToken e} {outToken o} {lineToken t}\"", .new = "    out.putStrLn s!\"{depth + 1} {eventToken e} {outToken o} {stateToken t}\"" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC28",
        .what = "failure_cause proved by sorry",
        .edits = .{
            .{ .file = "spec/lean/Spec/LookupProofs/Cause.lean", .old = "  exact key es _ (init_fits c)", .new = "  sorry" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
}
